# Modelo do .env de PRODUCAO. Copiar para .env e preencher. Nunca commitar o .env.

# --- Aplicacao ---
APP_NAME="SMS Gateway"
APP_DEBUG=false                  # NUNCA true em producao: mostraria detalhes tecnicos nas respostas
APP_TIMEZONE=Europe/Lisbon
LOG_LEVEL=info

# --- Base de dados (as nossas tabelas e as do programa de SMS estao todas nesta base) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smsphp
DB_USER=smsphp_app               # utilizador criado com sql\04_mysql_user.sql (nao usar o root)
DB_PASSWORD=

# --- Tabelas do programa de SMS ---
SMS_OUT_TABLE=sms_out
SMS_IN_TABLE=sms_in
SMS_QUEUE_TABLE=sms_queue

# --- Seguranca da API ---
AUTH_ENABLED=true
# Uma chave por aplicacao, longas e aleatorias. Gerar uma:
#   php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
API_KEYS=
# Opcional: so estes IPs podem usar a API (separados por virgula). Vazio = qualquer IP.
# O IP e o real do cliente (o Cloudflare Tunnel entrega-o em CF-Connecting-IP).
ALLOWED_IPS=

# --- Mensagens ---
MAX_TEXT_LENGTH=255

# --- Dispatcher (sms_queue -> sms_out) ---
DISPATCH_INTERVAL_SECONDS=5
DISPATCH_BATCH_SIZE=10

# --- Aprovacoes ---
APPROVAL_EXPIRY_MINUTES=10
APPROVAL_POLL_SECONDS=3
APPROVAL_SEND_FEEDBACK=true
APPROVAL_INBOX_BATCH=50

# --- Workers ---
WORKER_MAX_CONSECUTIVE_ERRORS=10

# --- Callbacks (avisar a APP quando um pedido e decidido) ---
CALLBACK_INTERVAL_SECONDS=5
CALLBACK_BATCH_SIZE=5
CALLBACK_TIMEOUT_SECONDS=5
# esperas entre tentativas, em minutos (a 1.a tentativa e logo): 7 tentativas em cerca de 1 hora
CALLBACK_RETRY_MINUTES=1,2,5,10,20,30
# false = so https e so enderecos publicos (protege a rede interna).
# true  = tambem http e redes internas: necessario se as APPs estiverem na rede da empresa.
CALLBACK_ALLOW_INTERNAL=false
