# Aplicação
APP_NAME="SMS Gateway"
APP_DEBUG=false
APP_TIMEZONE=Europe/Lisbon
LOG_LEVEL=info

# Base de dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sms
DB_USER=root
DB_PASSWORD=

# Tabelas do programa de SMS
SMS_OUT_TABLE=sms_out
SMS_IN_TABLE=sms_in
SMS_QUEUE_TABLE=sms_queue

# Segurança da API
AUTH_ENABLED=true
# várias chaves separadas por vírgula (usar valores longos e aleatórios)
API_KEYS=
# vazio = qualquer IP
ALLOWED_IPS=

# Mensagens
MAX_TEXT_LENGTH=255

# Dispatcher (sms_queue -> sms_out)
DISPATCH_INTERVAL_SECONDS=5
DISPATCH_BATCH_SIZE=10

# Workers: terminam (codigo 1) depois de tantos erros seguidos
WORKER_MAX_CONSECUTIVE_ERRORS=10
